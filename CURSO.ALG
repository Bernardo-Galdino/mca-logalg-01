Algoritmo "Curso"

Var

   Disciplina, Ano, Aluno : caractere


Inicio

   escreva("Nome do aluno: ")
   leia(Aluno)
   escreva("O aluno está cursando: ")
   leia(Disciplina)
   escreva("O aluno está em qual ano:")
   leia(Ano)
   escreval
   
   escreva("O aluno ", Aluno, " está cursando ", Disciplina, " no ano ", Ano, ".")


Fimalgoritmo